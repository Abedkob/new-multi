generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  STORE_OWNER
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role     @default(STORE_OWNER)
  mustChangePassword Boolean  @default(true)
  // Stamped into the session JWT at login and compared on every owner/admin request
  // (lib/session.ts). Bumping it (admin password reset) revokes every existing session.
  sessionVersion     Int      @default(0)
  createdAt          DateTime @default(now())

  // One owner owns exactly one tenant.
  tenant Tenant?
}

model Tenant {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  name                   String
  ownerId                String         @unique
  owner                  User           @relation(fields: [ownerId], references: [id])
  // Custom storefront domain (e.g. "acme.com") — set ONLY once it's verified and DNS actually
  // points here. Every URL-emitting surface (SEO helpers, sitemap, robots.txt, canonicals, and
  // the domain-routing proxy) trusts this field unconditionally and starts sending traffic and
  // search engines there the moment it's non-null. An unverified or mistyped value here sends
  // real traffic to a domain that doesn't serve this store. Null means the store is only
  // reachable at the platform's own /store/[slug] path. See lib/store-url.ts.
  domain                 String?        @unique
  // Per-store marketing integrations, set by the platform admin (/platform/stores/[slug]/...)
  // and injected into this store's storefront only. All nullable = off. Every value is
  // format-validated on save AND again before it is rendered into a <script> or <meta>
  // (lib/integrations.ts), since these strings end up in inline script text.
  gaMeasurementId        String? // GA4, "G-XXXXXXX"
  googleAdsId            String? // Google Ads tag, "AW-123456789"
  googleAdsPurchaseLabel String? // Ads conversion label for purchases, sent as AW-.../<label>
  metaPixelId            String? // Meta (Facebook/Instagram) Pixel / dataset id, digits
  googleSiteVerification String? // Search Console HTML-tag token (google-site-verification)
  metaDomainVerification String? // Meta Business domain verification token
  // Browser-tab icon for this store's storefront, set by the platform admin only (Branding
  // section). An image URL in our storage (lib/storage.ts). Null = a generated letter icon.
  faviconUrl             String?
  // Optional public profile/location links managed by the store owner. Null means the link is
  // not shown anywhere on the storefront.
  facebookUrl            String?
  instagramUrl           String?
  tiktokUrl              String?
  whatsappNumber         String?
  googleMapsUrl          String?
  // One simple store-wide delivery price. Orders snapshot both values at checkout so later
  // settings changes never rewrite order history.
  deliveryFeeCents       Int            @default(0)
  deliveryNote           String         @default("")
  templateId             String         @default("minimal")
  themeOverrides         Json           @default("{}")
  // Owner-controlled on/off switches for the optional storefront sections.
  // Missing keys fall back to defaults (see lib/sections.ts).
  sectionVisibility      Json           @default("{}")
  // Platform-admin pause state. Owners retain dashboard access; public storefront and checkout
  // are blocked while paused. Keep operator pause separate from provider license status.
  isPaused               Boolean        @default(false)
  pausedAt               DateTime?
  pauseReason            String?
  license                TenantLicense?
  createdAt              DateTime       @default(now())

  contents   TenantContent[]
  products   Product[]
  categories Category[]
  orders     Order[]
  discounts  DiscountCampaign[]
}

// Provider secrets stay encrypted at rest and are never selected into browser-facing props.
// One license activation belongs to exactly one store installation.
model TenantLicense {
  id                        String    @id @default(cuid())
  tenantId                  String    @unique
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installationId            String    @unique @default(uuid())
  productCode               String
  licenseKeyCiphertext      String
  keyHint                   String?
  activationTokenCiphertext String?
  status                    String    @default("PENDING")
  providerRequestId         String?
  activationId              String?
  licenseType               String?
  expiresAt                 DateTime?
  entitlements              Json?
  checkAfter                DateTime?
  offlineGraceUntil         DateTime?
  lastCheckedAt             DateTime?
  lastError                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([status, checkAfter])
}

// A tree of any depth (Men -> Shoes -> Nike). Slugs are unique per store because the
// storefront looks categories up by slug alone. Parent/child and product links use
// NoAction so a category that still has children or products cannot be deleted by accident;
// the app checks first and shows a clear message.
model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  imageUrl  String?
  createdAt DateTime   @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
}

model TenantContent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  value    String

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Stock and (optional) price/image live on variants. A product always has at least one; a
// product without real variation gets a single default variant with empty attributes.
// `attributes` is free-form ({ size: "40", color: "white" }), so there is no fixed schema.
model ProductVariant {
  id                 String      @id @default(cuid())
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes         Json        @default("{}")
  stock              Int         @default(0)
  priceCentsOverride Int?
  imageUrl           String?
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]

  @@index([productId])
}

model Product {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String            @default("")
  // Used when a variant has no price override of its own.
  basePriceCents Int
  imageUrl       String            @default("")
  slug           String
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  // Manually flagged for the "Best sellers" section (no sales data yet).
  isBestSeller   Boolean           @default(false)
  variants       ProductVariant[]
  images         ProductImage[]
  discounts      DiscountProduct[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Product slugs only need to be unique within a store.
  @@unique([tenantId, slug])
  // Supports the composite DiscountProduct FK that guarantees both rows share a tenant.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([categoryId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Reusable automatic product discounts. Status is derived at read time from these fields:
// archived, disabled, scheduled, active or ended. No scheduler is required for activation.
model DiscountCampaign {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  type       DiscountType
  // Whole percentage points for PERCENTAGE; integer cents for FIXED_AMOUNT.
  value      Int
  isEnabled  Boolean           @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  products   DiscountProduct[]

  @@unique([id, tenantId])
  @@index([tenantId, archivedAt, isEnabled])
  @@index([tenantId, startsAt, endsAt])
}

// tenantId participates in both composite foreign keys. PostgreSQL therefore rejects an
// assignment unless the campaign and product belong to exactly the same tenant.
model DiscountProduct {
  tenantId   String
  discountId String
  productId  String
  discount   DiscountCampaign @relation(fields: [discountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product    Product          @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@id([discountId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, discountId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

// Guest cash-on-delivery orders. Stock is deducted when the order is placed and restored if
// it is cancelled.
model Order {
  id                       String      @id @default(cuid())
  tenantId                 String
  tenant                   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName             String
  customerPhone            String
  customerAddress          String
  // A Google Maps link or a description of where to deliver (free text).
  deliveryLocation         String
  notes                    String      @default("")
  deliveryFeeCentsSnapshot Int         @default(0)
  deliveryNoteSnapshot     String      @default("")
  status                   OrderStatus @default(PENDING)
  createdAt                DateTime    @default(now())
  items                    OrderItem[]

  @@index([tenantId, createdAt])
}

// Name, attributes and price are copied at order time, so later edits to (or deletion of) the
// product never rewrite order history. `variantId` becomes null if the variant is deleted.
model OrderItem {
  id                        String          @id @default(cuid())
  orderId                   String
  order                     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId                 String?
  variant                   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot       String
  variantAttributesSnapshot Json            @default("{}")
  regularPriceCentsSnapshot Int
  discountCentsSnapshot     Int             @default(0)
  discountIdSnapshot        String?
  discountNameSnapshot      String?
  // The final unit price actually charged.
  priceCentsSnapshot        Int
  quantity                  Int

  @@index([orderId])
  @@index([variantId])
}
