generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  STORE_OWNER
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role     @default(STORE_OWNER)
  mustChangePassword Boolean  @default(true)
  // Stamped into the session JWT at login and compared on every owner/admin request
  // (lib/session.ts). Bumping it (admin password reset) revokes every existing session.
  sessionVersion     Int      @default(0)
  createdAt          DateTime @default(now())

  // One owner owns exactly one tenant.
  tenant Tenant?
}

model Tenant {
  id                        String         @id @default(cuid())
  slug                      String         @unique
  name                      String
  ownerId                   String         @unique
  owner                     User           @relation(fields: [ownerId], references: [id])
  // Custom storefront domain (e.g. "acme.com") — set ONLY once it's verified and DNS actually
  // points here. Every URL-emitting surface (SEO helpers, sitemap, robots.txt, canonicals, and
  // the domain-routing proxy) trusts this field unconditionally and starts sending traffic and
  // search engines there the moment it's non-null. An unverified or mistyped value here sends
  // real traffic to a domain that doesn't serve this store. Null means the store is only
  // reachable at the platform's own /store/[slug] path. See lib/store-url.ts.
  domain                    String?        @unique
  // Per-store marketing integrations, set by the platform admin (/platform/stores/[slug]/...)
  // and injected into this store's storefront only. All nullable = off. Every value is
  // format-validated on save AND again before it is rendered into a <script> or <meta>
  // (lib/integrations.ts), since these strings end up in inline script text.
  gaMeasurementId           String? // GA4, "G-XXXXXXX"
  googleAdsId               String? // Google Ads tag, "AW-123456789"
  googleAdsPurchaseLabel    String? // Ads conversion label for purchases, sent as AW-.../<label>
  metaPixelId               String? // Meta (Facebook/Instagram) Pixel / dataset id, digits
  googleSiteVerification    String? // Search Console HTML-tag token (google-site-verification)
  metaDomainVerification    String? // Meta Business domain verification token
  // Browser-tab icon for this store's storefront, set by the platform admin only (Branding
  // section). An image URL in our storage (lib/storage.ts). Null = a generated letter icon.
  faviconUrl                String?
  // Optional public profile/location links managed by the store owner. Null means the link is
  // not shown anywhere on the storefront.
  facebookUrl               String?
  instagramUrl              String?
  tiktokUrl                 String?
  whatsappNumber            String?
  googleMapsUrl             String?
  // One simple store-wide delivery price. Orders snapshot both values at checkout so later
  // settings changes never rewrite order history.
  deliveryFeeCents          Int            @default(0)
  deliveryNote              String         @default("")
  templateId                String         @default("minimal")
  themeOverrides            Json           @default("{}")
  // Owner-controlled on/off switches for the optional storefront sections.
  // Missing keys fall back to defaults (see lib/sections.ts).
  sectionVisibility         Json           @default("{}")
  // Platform-admin pause state. Owners retain dashboard access; public storefront and checkout
  // are blocked while paused. Keep operator pause separate from provider license status.
  isPaused                  Boolean        @default(false)
  pausedAt                  DateTime?
  pauseReason               String?
  // --- Storefront analytics: privacy identity, reporting basis, launch control --------------
  // The platform and the merchant are JOINT CONTROLLERS for storefront analytics, so each store
  // has to be able to name its own controller and privacy contact on its privacy page. Set by
  // the platform admin at store creation; NULL means privacy setup is incomplete and the store
  // must not be put into the analytics rollout (pnpm verify:consent fails while it is).
  privacyControllerName     String?
  privacyEmail              String?
  privacyPolicyUrl          String?
  // Which version of the joint-controller arrangement was recorded, when, and by which platform
  // operator (a User id) — the audit trail behind the arrangement itself.
  jointControllerVersion    String?
  jointControllerRecordedAt DateTime?
  jointControllerRecordedBy String?
  // IANA zone the store's business day is resolved in (daily/hourly reports, weekly summaries).
  // Timestamps are always stored in UTC; this only decides where the day boundary falls, so a
  // viewer's own device timezone never redefines the store's day.
  analyticsTimezone         String         @default("Asia/Beirut")
  // Language the storefront consent notice opens in, and the fallback for owner notifications.
  defaultLocale             String         @default("en")
  // Bumping this asks every visitor for consent again (a changed notice needs a fresh decision).
  consentNoticeVersion      Int            @default(1)
  // Platform-only emergency stop for analytics. Deliberately NOT isPaused: that takes the whole
  // storefront offline, this only silences measurement and leaves the store selling.
  analyticsPausedAt         DateTime?
  analyticsPauseReason      String?
  license                   TenantLicense?
  createdAt                 DateTime       @default(now())

  contents                  TenantContent[]
  products                  Product[]
  categories                Category[]
  orders                    Order[]
  discounts                 DiscountCampaign[]
  coupons                   Coupon[]
  consentReceipts           AnalyticsConsentReceipt[]
  analyticsVisitors         AnalyticsVisitor[]
  analyticsDaily            AnalyticsDailyMetric[]
  analyticsHourly           AnalyticsHourlyMetric[]
  analyticsProductDaily     AnalyticsProductDaily[]
  analyticsSearchDaily      AnalyticsSearchDaily[]
  analyticsAcquisitionDaily AnalyticsAcquisitionDaily[]
  analyticsCursors          AnalyticsAggregationCursor[]
  analyticsAuditLogs        AnalyticsAuditLog[]
  marketingCampaigns        MarketingCampaign[]
}

// A campaign the owner saved while building a tracked link (D39).
//
// Reports never read this table. A campaign is whatever `utm_campaign` value came back in the
// data, so a report cannot depend on bookkeeping an owner forgot — and this row cannot disagree
// with one, because it holds no numbers at all. What it buys is the first hour: a Campaigns tab
// that shows the link you just built, with zeros, instead of an empty page that reads as broken.
//
// `utmCampaign` is the normalized value the link carries, and it is what joins a saved row to
// the observed numbers. It is unique per tenant: two saved rows for one utm value would show the
// same traffic twice under two names.
model MarketingCampaign {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /** What the owner called it. Shown in the admin; never matched against the data. */
  name            String
  /** The normalized utm_campaign value — the join key, and the only field a report could see. */
  utmCampaign     String
  /** The builder's channel id ("instagram", "whatsapp", "custom", …), for the owner's recall. */
  channel         String
  /** Where the link pointed, relative to the store base ("" for home). */
  destinationPath String    @default("")
  createdAt       DateTime  @default(now())
  archivedAt      DateTime?

  @@unique([tenantId, utmCampaign])
  @@index([tenantId, archivedAt, createdAt])
}

// One row per consent decision a storefront visitor makes. It records THAT a decision was made
// and what it granted — never who made it. There is deliberately no IP, no user-agent string and
// no visitor identifier here: a receipt is evidence the choice was honoured, not a profile. The
// visitor's own copy of the decision is the signed cookie; this is ours.
//
// `publicRef` is the only part a visitor ever sees: Cookie settings shows it so they can quote it
// in a privacy request without us having to identify them by anything else.
model AnalyticsConsentReceipt {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Shown to the visitor in Cookie settings; safe to disclose, meaningless without this table.
  publicRef          String   @unique @default(cuid())
  // Tenant.consentNoticeVersion at the moment of the decision.
  noticeVersion      Int
  analyticsGranted   Boolean
  advertisingGranted Boolean
  // The language the notice was actually shown in when the choice was made ("en" | "ar").
  locale             String
  // BANNER_ACCEPT_ALL | BANNER_REJECT | MANAGE | FOOTER_WITHDRAW — how the choice was expressed.
  decisionMethod     String
  // Country from trusted proxy metadata; coarse device class. Both optional, both non-identifying.
  country            String?
  deviceClass        String?
  decidedAt          DateTime @default(now())
  // Mirrors the cookie's own lifetime (~6 months). Retention deletes rows 24 months past this.
  expiresAt          DateTime

  // Composite key so future tenant-scoped children can carry a composite foreign key, the way
  // CouponProduct references Coupon(id, tenantId).
  @@unique([id, tenantId])
  @@index([tenantId, decidedAt])
  // Retention sweeps by expiry across every tenant (Phase 4's scheduled command).
  @@index([expiresAt])
}

// Provider secrets stay encrypted at rest and are never selected into browser-facing props.
// One license activation belongs to exactly one store installation.
model TenantLicense {
  id                        String    @id @default(cuid())
  tenantId                  String    @unique
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installationId            String    @unique @default(uuid())
  productCode               String
  licenseKeyCiphertext      String
  keyHint                   String?
  activationTokenCiphertext String?
  status                    String    @default("PENDING")
  providerRequestId         String?
  activationId              String?
  licenseType               String?
  expiresAt                 DateTime?
  entitlements              Json?
  checkAfter                DateTime?
  offlineGraceUntil         DateTime?
  lastCheckedAt             DateTime?
  lastError                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([status, checkAfter])
}

// A tree of any depth (Men -> Shoes -> Nike). Slugs are unique per store because the
// storefront looks categories up by slug alone. Parent/child and product links use
// NoAction so a category that still has children or products cannot be deleted by accident;
// the app checks first and shows a clear message.
model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  imageUrl  String?
  createdAt DateTime   @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
}

model TenantContent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  value    String

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Stock and (optional) price/image live on variants. A product always has at least one; a
// product without real variation gets a single default variant with empty attributes.
// `attributes` is free-form ({ size: "40", color: "white" }), so there is no fixed schema.
model ProductVariant {
  id                 String      @id @default(cuid())
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes         Json        @default("{}")
  stock              Int         @default(0)
  priceCentsOverride Int?
  imageUrl           String?
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]

  @@index([productId])
}

model Product {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String            @default("")
  // Used when a variant has no price override of its own.
  basePriceCents Int
  imageUrl       String            @default("")
  slug           String
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  // Manually flagged for the "Best sellers" section (no sales data yet).
  isBestSeller   Boolean           @default(false)
  variants       ProductVariant[]
  images         ProductImage[]
  discounts      DiscountProduct[]
  coupons        CouponProduct[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Product slugs only need to be unique within a store.
  @@unique([tenantId, slug])
  // Supports the composite DiscountProduct FK that guarantees both rows share a tenant.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([categoryId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  ORDER_SUBTOTAL
  SELECTED_PRODUCTS
  FREE_DELIVERY
}

// Reusable automatic product discounts. Status is derived at read time from these fields:
// archived, disabled, scheduled, active or ended. No scheduler is required for activation.
model DiscountCampaign {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  type       DiscountType
  // Whole percentage points for PERCENTAGE; integer cents for FIXED_AMOUNT.
  value      Int
  isEnabled  Boolean           @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  products   DiscountProduct[]

  @@unique([id, tenantId])
  @@index([tenantId, archivedAt, isEnabled])
  @@index([tenantId, startsAt, endsAt])
}

// tenantId participates in both composite foreign keys. PostgreSQL therefore rejects an
// assignment unless the campaign and product belong to exactly the same tenant.
model DiscountProduct {
  tenantId   String
  discountId String
  productId  String
  discount   DiscountCampaign @relation(fields: [discountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product    Product          @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@id([discountId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, discountId])
}

model Coupon {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String?
  code             String
  scope            CouponScope
  type             DiscountType?
  value            Int?
  isEnabled        Boolean         @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  isAnnounced      Boolean         @default(false)
  announcementText String          @default("")
  archivedAt       DateTime?
  revision         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  products         CouponProduct[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, archivedAt, isEnabled])
  @@index([tenantId, startsAt, endsAt])
}

model CouponProduct {
  tenantId  String
  couponId  String
  productId String
  coupon    Coupon   @relation(fields: [couponId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product   Product  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([couponId, productId])
  @@index([tenantId, productId])
  @@index([tenantId, couponId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

// Guest cash-on-delivery orders. Stock is deducted when the order is placed and restored if
// it is cancelled.
model Order {
  id                                     String       @id @default(cuid())
  tenantId                               String
  tenant                                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName                           String
  customerPhone                          String
  customerAddress                        String
  // A Google Maps link or a description of where to deliver (free text).
  deliveryLocation                       String
  notes                                  String       @default("")
  deliveryFeeCentsSnapshot               Int          @default(0)
  deliveryNoteSnapshot                   String       @default("")
  couponIdSnapshot                       String?
  couponCodeSnapshot                     String?
  couponNameSnapshot                     String?
  couponScopeSnapshot                    CouponScope?
  couponMerchandiseDiscountCentsSnapshot Int          @default(0)
  couponDeliveryDiscountCentsSnapshot    Int          @default(0)
  couponDiscountCentsSnapshot            Int          @default(0)
  status                                 OrderStatus  @default(PENDING)
  createdAt                              DateTime     @default(now())
  /// Touched by every write, including a status change. Phase 4's aggregates need it: cash on
  /// delivery means a cancellation routinely lands days after the order, and the daily figures
  /// for the day it was PLACED have to be recomputed when that happens (D33). Without this
  /// column there is no way to ask which days a late change affected.
  updatedAt                              DateTime     @updatedAt @default(now())
  items                                  OrderItem[]

  // Analytics attribution, snapshotted at purchase time (Phase 3, master plan 9.1). All
  // nullable and written exactly once, inside the order's own transaction: an order placed by a
  // visitor who refused analytics records nulls and is otherwise completely unaffected. A later
  // change to the session or visitor must never rewrite what an order says about itself, which
  // is the same rule the price and coupon snapshots above follow.
  //
  // Deliberately NOT a foreign key to AnalyticsSession: retention deletes sessions after 13
  // months while orders are kept for commercial and tax reasons, and a foreign key would either
  // block that deletion or cascade it into the order. These are references for reconciliation,
  // not relations.
  // The session is the single reconciliation key, and privacy erasure clears it
  // (forgetOrderAttributionLinks) while leaving the non-identifying dimensions below.
  //
  // There is deliberately NO visitor id here. A visitor id is a durable pseudonymous
  // identifier, and an order is kept for years, outside the analytics retention sweep: storing
  // one would let any order be tied back to a person's entire browsing history for this store,
  // which is exactly what the privacy rules forbid. What a merchant actually needs from it is
  // "had this shopper been here before", so that is what is stored — a boolean, which cannot be
  // re-identified. Null means unknown (no consent, or no identity yet).
  analyticsSessionId   String?
  isReturningVisitor   Boolean?
  // Last non-direct touch of the session that placed the order.
  attributionSource    String?
  attributionMedium    String?
  attributionCampaign  String?
  // The visitor's first ever touch for this store.
  firstTouchSource     String?
  firstTouchMedium     String?
  firstTouchCampaign   String?
  analyticsCountry     String?
  analyticsDeviceClass String?

  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
}

// Name, attributes and price are copied at order time, so later edits to (or deletion of) the
// product never rewrite order history. `variantId` becomes null if the variant is deleted.
model OrderItem {
  id                          String          @id @default(cuid())
  orderId                     String
  order                       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId                   String?
  variant                     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot         String
  variantAttributesSnapshot   Json            @default("{}")
  regularPriceCentsSnapshot   Int
  discountCentsSnapshot       Int             @default(0)
  discountIdSnapshot          String?
  discountNameSnapshot        String?
  couponDiscountCentsSnapshot Int             @default(0)
  // The final unit price actually charged.
  priceCentsSnapshot          Int
  quantity                    Int

  @@index([orderId])
  @@index([variantId])
}

// --- Storefront analytics: collection ---------------------------------------------------------
//
// Three tables, all tenant-scoped and all under forced RLS. Cascade runs down the chain
// Tenant -> Visitor -> Session -> Event, so deleting a store takes every row with it without
// needing a direct tenant foreign key on the children.
//
// Sessions and events reach their tenant through COMPOSITE foreign keys on (id, tenantId), the
// same shape CouponProduct uses: a session cannot point at a visitor in another store, and an
// event cannot point at a session in another store, even if application code slips. That is
// structural, not a rule anyone has to remember.

/// One browser per store. Deliberately per-store: the cookie is tenant-scoped, so the same
/// person visiting two stores is two unrelated visitors and nothing can correlate them.
model AnalyticsVisitor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  // Coarse and non-identifying, exactly as on a consent receipt.
  country       String?
  deviceClass   String?
  // First touch, kept so Phase 4 can offer the first/last attribution switch.
  firstSource   String?
  firstMedium   String?
  firstCampaign String?

  sessions AnalyticsSession[]
  events   AnalyticsEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, lastSeenAt])
}

/// Activity separated by no more than 30 minutes of inactivity. Carries the acquisition
/// dimensions so Phase 4 reports from sessions rather than re-deriving them from events.
model AnalyticsSession {
  id        String           @id @default(cuid())
  tenantId  String
  visitorId String
  visitor   AnalyticsVisitor @relation(fields: [visitorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  country         String?
  deviceClass     String?
  landingPageKind String?

  /// Which rung of §3.5's ladder this arrival came from: campaign, paid, social, search,
  /// referral or direct. Classified once, server-side (lib/analytics/attribution.ts), so no two
  /// reports can disagree about what a channel is.
  sourceKind   String?
  /// Hostname only. Never a full referring URL: a path can carry a search query or a username.
  referrerHost String?

  // Last non-direct touch for this session (D24: updated when a later batch brings one).
  source     String?
  medium     String?
  campaign   String?
  content    String?
  // Presence of a gclid/fbclid, never the value: the marker is useful, the id identifies a click.
  hasAdClick Boolean @default(false)

  events AnalyticsEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, startedAt])
  @@index([tenantId, lastActivityAt])
  @@index([tenantId, sourceKind, startedAt])
}

/// Typed columns rather than arbitrary JSON, so what can be stored is visible in the schema.
/// (tenantId, eventId) is unique, which is what makes a retried beacon free and lets the
/// browser keep no durable retry queue.
model AnalyticsEvent {
  id       String @id @default(cuid())
  tenantId String
  /// Client-generated UUID; the deduplication key.
  eventId  String

  type       AnalyticsEventType
  /// Client clock, clamped server-side.
  occurredAt DateTime
  receivedAt DateTime           @default(now())

  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  visitorId String
  visitor   AnalyticsVisitor @relation(fields: [visitorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// A normalized page kind, never a URL.
  pageKind String

  productId   String?
  variantId   String?
  quantity    Int?
  /// Normalized and PII-scrubbed server-side; Phase 4 starts emitting these.
  searchQuery String?
  resultCount Int?
  /// Server-computed only (Phase 3's WhatsApp potential value). Never accepted from a client.
  valueCents  Int?

  @@unique([tenantId, eventId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  SEARCH_SUBMITTED
  SEARCH_RESULT_CLICK
  ADD_TO_CART
  REMOVE_FROM_CART
  CART_VIEW
  CHECKOUT_STARTED
  WHATSAPP_ORDER_CLICK
}

/// One stage of one `pnpm analytics:scheduled` invocation (§10).
///
/// Deliberately NOT tenant-scoped and NOT under RLS: a run record is operational bookkeeping
/// about the platform's own job, not a store's data, and the job is cross-tenant by nature.
/// Only the platform admin ever reads it, through the existing narrow bypass path.
///
/// `leaseUntil` is what makes a crashed run recoverable. The advisory lock is released the
/// moment the process dies, so the next invocation can start — but the row it left behind still
/// says RUNNING. A run whose lease has passed is marked EXPIRED and its stage is run again.
model AnalyticsScheduledRun {
  id    String @id @default(cuid())
  stage String

  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  leaseUntil DateTime
  status     AnalyticsRunStatus @default(RUNNING)

  /// Whatever the stage counts: tenants processed, rows deleted, days recomputed.
  items  Int     @default(0)
  /// A one-line note for the platform admin; never a stack trace, never store data.
  detail String?
  /// Set when the stage threw. The run keeps going; the command exits non-zero.
  error  String?
  /// True when this run was told to change nothing (retention's dry run, D35).
  dryRun Boolean @default(false)

  @@index([stage, startedAt])
  @@index([status, leaseUntil])
}

enum AnalyticsRunStatus {
  RUNNING
  OK
  FAILED
  /// The process died holding this stage; a later run found the lease expired.
  EXPIRED
}

// --- Storefront analytics: aggregates (§9.3, §10, Phase 4) ------------------------------------
//
// Reports read these, never the raw events. Three reasons, in order of how much they matter:
// a merchant page must not scan millions of rows; raw events are deleted after 90 days while
// these are kept for 24 months; and a figure computed once is a figure two reports cannot
// disagree about.
//
// Every one of them is a RECOMPUTE, never an increment (D25). Each run deletes the rows for a
// local day and writes them again from the raw data, which makes late events, retried beacons
// and order-status changes self-correcting and the whole job safely re-runnable. Nothing here
// is ever "+1"-ed in place.
//
// All tenant-scoped and all under forced RLS, like every other table a store owns.
//
// `localDay` is a DATE in the STORE's zone and `timeZone` records which zone computed it, so a
// store that changes zone later produces visibly different rows rather than silently rewriting
// its own history (P4-08).

model AnalyticsDailyMetric {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  localDay DateTime @db.Date
  timeZone String

  /// Unique sessions, which is the unit the whole funnel is counted in (§3.2) — not page views.
  sessions    Int @default(0)
  visitors    Int @default(0)
  /// Visitors whose first-ever session for this store started on this day.
  newVisitors Int @default(0)

  // The funnel, in sessions that reached each step.
  productViewSessions Int @default(0)
  addToCartSessions   Int @default(0)
  cartViewSessions    Int @default(0)
  checkoutSessions    Int @default(0)
  searchSessions      Int @default(0)

  /// Sessions that clicked "order on WhatsApp", and what those clicks were worth IF they all
  /// converted. Intent, never revenue (§3.4) — kept in its own column so no helper can add it
  /// to the order value next to it.
  whatsappClickSessions       Int @default(0)
  whatsappPotentialValueCents Int @default(0)

  /// Website orders, from the orders themselves. Analytics stores no second copy of an order's
  /// money: these are totalled with lib/orders.ts's orderTotal, the same function the order
  /// page uses, so the two cannot drift (P3-01).
  orders                   Int @default(0)
  orderValueCents          Int @default(0)
  /// Cancelled orders stay conversions (someone chose to buy) and leave the value totals above.
  cancelledOrders          Int @default(0)
  cancelledOrderValueCents Int @default(0)

  computedAt DateTime @default(now())

  @@unique([tenantId, localDay])
  @@index([tenantId, localDay])
}

/// The shape of a day. Deliberately narrow: an hourly row per metric would quadruple the table
/// for a question nobody asks hourly.
model AnalyticsHourlyMetric {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  localDay DateTime @db.Date
  timeZone String
  /// 0-23 as the store's clock showed it. A spring-forward day simply has no row for the hour
  /// that did not happen, and a fall-back day's repeated hour is one row (lib/analytics/
  /// local-day.ts explains why an hour is a label, not a duration).
  hour     Int

  sessions        Int @default(0)
  orders          Int @default(0)
  orderValueCents Int @default(0)

  computedAt DateTime @default(now())

  @@unique([tenantId, localDay, hour])
  @@index([tenantId, localDay])
}

model AnalyticsProductDaily {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  localDay  DateTime @db.Date
  timeZone  String
  /// Not a foreign key: a product deleted next year must not erase what it sold today.
  productId String
  /// What the product was called THAT DAY, snapshotted like an order item's name (D44). Without
  /// it, deleting a product makes every past row unnameable. Nullable because rows written
  /// before this column existed have no honest value: null means "not recorded", which the
  /// report shows as "Deleted product" rather than as an empty name.
  productName String?

  viewSessions          Int @default(0)
  views                 Int @default(0)
  /// Distinct visitors who viewed it, and how many of them had seen the store before today.
  /// Nullable for the same reason as productName: a 0 on a day that never measured them would
  /// read as "nobody", which is a different claim from "unknown" (D48a).
  viewVisitors          Int?
  returningViewVisitors Int?
  addToCartSessions     Int @default(0)
  whatsappClickSessions Int @default(0)
  /// Sessions that bought this product. Reached through OrderItem.variantId -> ProductVariant,
  /// because an order item snapshots a NAME, not a product id; an item whose variant was
  /// deleted outright can no longer name its product and is left out rather than guessed at.
  purchasingSessions    Int @default(0)
  unitsOrdered          Int @default(0)
  orderValueCents       Int @default(0)

  computedAt DateTime @default(now())

  @@unique([tenantId, localDay, productId])
  @@index([tenantId, localDay])
  @@index([tenantId, productId, localDay])
}

model AnalyticsSearchDaily {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  localDay DateTime @db.Date
  timeZone String
  /// The normalized phrase (lib/analytics/search-text.ts), or "[redacted]".
  phrase   String

  searches            Int     @default(0)
  searchSessions      Int     @default(0)
  noResultSearches    Int     @default(0)
  resultClickSessions Int     @default(0)
  /// True for the "[redacted]" row. It still counts as searching — hiding it would understate
  /// every total — but it must never reach a "what should I stock" suggestion, because whoever
  /// typed it was not shopping (D22, P4-12).
  redacted            Boolean @default(false)

  computedAt DateTime @default(now())

  @@unique([tenantId, localDay, phrase])
  @@index([tenantId, localDay])
}

/// Channels, with first touch and last touch side by side so §5.5's switch is a column choice
/// rather than a different query.
model AnalyticsAcquisitionDaily {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  localDay   DateTime @db.Date
  timeZone   String
  /// campaign | paid | social | search | referral | direct (lib/analytics/attribution.ts).
  sourceKind String
  /// Empty strings rather than nulls: these are part of a unique key, and in Postgres every
  /// NULL is distinct from every other, so a nullable key would let the same channel insert
  /// itself twice and make the recompute non-idempotent.
  source     String   @default("")
  medium     String   @default("")
  campaign   String   @default("")

  sessions Int @default(0)
  /// The rest of what §5.5 asks for per source (D48). Nullable, not 0: these were added after
  /// the table, and a zero on a day that never counted them is indistinguishable from a day
  /// when nothing happened. The report refuses to total a range that contains either.
  visitors            Int?
  productViewSessions Int?
  cartSessions        Int?
  /// Intent, per source. Separate column, never added to an order value (§3.4).
  whatsappPotentialValueCents Int?

  lastTouchOrders           Int @default(0)
  lastTouchOrderValueCents  Int @default(0)
  firstTouchOrders          Int @default(0)
  firstTouchOrderValueCents Int @default(0)

  whatsappClickSessions Int @default(0)

  computedAt DateTime @default(now())

  @@unique([tenantId, localDay, sourceKind, source, medium, campaign])
  @@index([tenantId, localDay])
}

/// How far each stage has got for each store, and what went wrong if it did (§10).
model AnalyticsAggregationCursor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stage           String
  /// The most recent local day this stage has computed for this store.
  lastComputedDay DateTime? @db.Date
  lastRunAt       DateTime?
  /// Consecutive failures. Phase 6 alerts on a store that keeps failing while others succeed.
  failures        Int       @default(0)
  lastError       String?

  @@unique([tenantId, stage])
  @@index([stage, lastRunAt])
}

/// Who looked at or erased what (§9.3, D36).
///
/// Deliberately NOT under RLS and deliberately not cascaded away with the store: an audit
/// record about a store is evidence ABOUT that store, not data belonging to it. A store owner
/// must not be able to read, edit or delete it, and deleting a store must not quietly erase the
/// record of what was done to its shoppers' data — so `tenantId` is nullable with SetNull and
/// the actor's email is snapshotted, leaving a readable trail even when both rows are gone.
model AnalyticsAuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// The platform admin who acted. Snapshotted, for the same reason as the tenant.
  actorUserId String?
  actorEmail  String

  /// PRIVACY_SUMMARY | PRIVACY_EXPORT | PRIVACY_ERASE, and Phase 5's report access.
  action String
  /// What was acted on — a privacy identifier, never a name or a phone number.
  subject String?
  /// One line for a human: counts, not contents.
  detail String?

  at DateTime @default(now())

  @@index([tenantId, at])
  @@index([action, at])
}

/// A flushed snapshot of one process's ingestion counters (§11.10, D34).
///
/// Not tenant-scoped and not under RLS: these are the platform's operational numbers about its
/// own ingestion, not any store's data, and the point of them is to be comparable ACROSS
/// stores and instances.
///
/// Written by the web process that owns the counters, because nothing else can: they live in
/// that process's memory, the scheduled command runs in a different container, and an internal
/// endpoint would reach one arbitrary instance behind the proxy. The scheduler only reads.
///
/// An instance that received no traffic writes no row. "No rows" therefore means silence, not
/// failure, and an alert must never confuse the two.
model AnalyticsOperationalMetric {
  id String @id @default(cuid())

  /// hostname:pid — enough to tell two instances apart without naming infrastructure.
  instance String

  windowStart DateTime
  windowEnd   DateTime

  attemptedBatches       Int @default(0)
  acceptedBatches        Int @default(0)
  storedEvents           Int @default(0)
  rejectedOwnershipEvents Int @default(0)

  /// The three kinds, kept apart on purpose (D29). A policy drop is the system working, an
  /// operational drop is the system struggling, and a contract rejection is OUR OWN code
  /// sending something the contract refuses — three different thresholds, never one rate.
  policyDrops        Int @default(0)
  operationalDrops   Int @default(0)
  contractRejections Int @default(0)

  /// Per-reason detail, for a platform admin looking at a spike rather than an alert deciding
  /// whether to fire. JSON because the reasons are a closed list in code that may grow.
  policyDetail      Json @default("{}")
  operationalDetail Json @default("{}")

  at DateTime @default(now())

  @@index([at])
  @@index([instance, at])
}
