# These variables are validated at startup by lib/env.ts (fail-fast with a clear message).
# Set SKIP_ENV_VALIDATION=1 to bypass, e.g. during a container image build.

# PostgreSQL connection string — the OWNER/superuser role. Used by Prisma migrations,
# `pnpm db:seed` and the dev/CI scripts, all of which bypass Row-Level Security.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Used only by `pnpm db:seed` to create the platform admin
PLATFORM_ADMIN_EMAIL="you@example.com"
PLATFORM_ADMIN_PASSWORD="choose-a-strong-password"

# Restricted, non-superuser role the Next.js RUNTIME connects as. Row-Level Security policies
# (see prisma/migrations/*_row_level_security) enforce tenant isolation against this role;
# every tenant-scoped query runs through withTenant()/withBypass() in lib/prisma.ts.
# Create the role with scripts/sql/rls-role.sql. If unset, the runtime falls back to
# DATABASE_URL and RLS is NOT enforced.
APP_DATABASE_URL="postgresql://app_user:APP_PASSWORD@localhost:5432/DBNAME"
