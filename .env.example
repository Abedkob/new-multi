# These variables are validated at startup by lib/env.ts (fail-fast with a clear message).
# Set SKIP_ENV_VALIDATION=1 to bypass, e.g. during a container image build.

# PostgreSQL connection string — the OWNER/superuser role. Used by Prisma migrations,
# `pnpm db:seed` and the dev/CI scripts, all of which bypass Row-Level Security.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Required when self-hosting in production (`next start` behind nginx/Caddy): without it Auth.js
# rejects every sign-in with "UntrustedHost". Only set it when the reverse proxy in front of
# Next sets the Host header itself (the default for nginx/Caddy). Not needed on Vercel or in dev.
AUTH_TRUST_HOST="true"
# Used only by `pnpm db:seed` to create the platform admin
PLATFORM_ADMIN_EMAIL="you@example.com"
PLATFORM_ADMIN_PASSWORD="choose-a-strong-password"

# Restricted, non-superuser role the Next.js RUNTIME connects as. Row-Level Security policies
# (see prisma/migrations/*_row_level_security) enforce tenant isolation against this role;
# every tenant-scoped query runs through withTenant()/withBypass() in lib/prisma.ts.
# Create the role with scripts/sql/rls-role.sql. If unset, the runtime falls back to
# DATABASE_URL and RLS is NOT enforced.
APP_DATABASE_URL="postgresql://app_user:APP_PASSWORD@localhost:5432/DBNAME"

# Origin the platform is served from (no trailing slash). Required in production — sitemaps,
# robots.txt and canonical tags for path-based stores (/store/[slug]) build absolute URLs from
# this. Falls back to http://localhost:3000 in development. A store with its own custom domain
# (set on Tenant.domain) doesn't use this at all — see lib/store-url.ts.
PLATFORM_BASE_URL="https://shops.example.com"

# This server's own public IPv4 (your VPS's address). Required in production — connecting a
# custom domain in the platform admin (Stores -> a store -> Domain) requires its DNS A record to
# match this IP exactly before saving. Optional in development, where the check only requires
# the domain to resolve to *something*. Note: a domain behind Cloudflare's proxy (orange cloud)
# resolves to Cloudflare's IPs and will be rejected — use DNS-only (grey cloud) for the A record.
SERVER_PUBLIC_IP="203.0.113.10"

# Number of reverse proxies YOU run in front of Next that append to X-Forwarded-For (1 = just
# nginx/Caddy; 2 = e.g. Cloudflare -> nginx). The rate limiter reads the client IP that many
# entries from the right, so a client can't spoof its way past login/checkout limits.
TRUSTED_PROXY_COUNT="1"

# --- The edge (Phase 7, D75) ---------------------------------------------------------------
# Whether an edge sits in front of this origin, and so whether the proxy metadata that arrives
# with a request (cf-ipcountry, cf-connecting-ip, ...) may be believed at all. Full runbook,
# including the break-glass path and the order these are turned on in: EDGE_HARDENING.md.
#
#   off        (default) No edge declared: the headers are believed, exactly as they were
#              before Phase 7. Correct for `pnpm dev`, and for an origin nobody can reach
#              directly. It is NOT correct for a publicly reachable production origin — anyone
#              who can reach it can write a country of their choosing into the analytics tables.
#   cloudflare A request is believed only when it carries EDGE_SHARED_SECRET in x-edge-token,
#              which a Cloudflare Transform Rule adds and a direct client cannot guess.
EDGE_TRUST_MODE="off"

# The secret for that Transform Rule. Required when EDGE_TRUST_MODE=cloudflare (the app refuses
# to boot without it, rather than quietly trusting nothing). Generate with:
#   openssl rand -hex 32
# EDGE_SHARED_SECRET=""

# Redirect a request that arrived over plain HTTP (an explicit x-forwarded-proto: http) to
# https. Leave off until the edge terminates TLS and Cloudflare's own "Always Use HTTPS" is on.
EDGE_FORCE_HTTPS="false"

# Strict-Transport-Security max-age in seconds; 0 means the header is absent. Stays 0 in every
# committed configuration and is turned on BY HAND, last, after the pilot store has served a
# week of real traffic (D74) - it is the one setting that cannot be withdrawn quickly. A year is
# 31536000. Needs EDGE_FORCE_HTTPS="true".
EDGE_HSTS_MAX_AGE="0"

# Redis connection string for distributed rate limiting and domain cache. Required in production
# when running multiple app instances (single instance deployment can leave this unset).
# Format: redis://:password@host:port or redis://host:port (no auth)
# REDIS_URL="redis://:password@localhost:6379"

# Per-store licensing. Provider credentials and the encryption key stay server-side.
# Generate the encryption key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
LICENSE_API_BASE_URL="https://rlcphqlmnacxhzrffhjg.supabase.co/functions/v1/license-api"
LICENSE_PRODUCT_CODE="idevelopit-ecom-subscription"
LICENSE_APPLICATION_VERSION="0.1.0"
LICENSE_PLATFORM="linux"
LICENSE_API_TIMEOUT_MS="10000"
# Required before activating a store license; never use the test key here.
LICENSE_ENCRYPTION_KEY=""
# Required for Dockploy scheduled heartbeats; generate a separate random secret of 32+ characters.
LICENSE_HEARTBEAT_SECRET=""

# --- Storefront analytics (STOREFRONT_ANALYTICS_MASTER_PLAN.md §14) --------------------------
# How far first-party analytics COLLECTION has rolled out: off | pilot | all.
# The consent banner and the gating of per-store GA/Ads/Meta tags are NOT controlled by this —
# they apply to every store from day one, whatever the rollout says.
ANALYTICS_ROLLOUT_MODE="off"
# The one store collection runs for while ANALYTICS_ROLLOUT_MODE=pilot (required in that mode).
ANALYTICS_PILOT_TENANT_SLUG=""
# Signs the per-store consent cookie. Required in production.
# Generate with: openssl rand -base64 32
ANALYTICS_SIGNING_SECRET=""
# Bump when you rotate ANALYTICS_SIGNING_SECRET; visitors are then asked for consent again.
ANALYTICS_SIGNING_KEY_VERSION="1"

# The PLATFORM's own privacy identity. The platform and each merchant are JOINT CONTROLLERS for
# storefront analytics, so these appear on every store's privacy page beside the merchant's own
# contact details. Name and email are required in production.
PLATFORM_PRIVACY_NAME="Your Company"
PLATFORM_PRIVACY_EMAIL="privacy@example.com"
PLATFORM_PRIVACY_URL="https://example.com/privacy"
# Defaults a newly created store starts with; each store can be changed afterwards.
PLATFORM_DEFAULT_LOCALE="en"
# IANA zone used for reporting days/hours and weekly notifications. Validated at startup.
PLATFORM_TIMEZONE="Asia/Beirut"
# The platform owner's own GA4 property (this deployment's traffic). Loaded on the admin,
# platform and login pages only — never on a storefront.
PLATFORM_GA_ID=""

# Collection tuning. The ingestion pool is separate from the application's and deliberately
# small, so a burst of analytics can never take the connections checkout needs
# (PRODUCTION.md has the per-instance arithmetic against max_connections).
ANALYTICS_DATABASE_POOL_MAX="5"
# The scheduled command runs in its own container, so this is its own pool, not a share of the
# app's. Two is enough for a job that walks tenants in bounded batches.
ANALYTICS_JOB_DATABASE_POOL_MAX="2"
ANALYTICS_MAX_BATCH_SIZE="20"
# §11.10's ingestion alert thresholds. The contract-rejection one is a COUNT, not a percentage,
# and deliberately small: a 400 means our own code sent something the contract refuses.
ANALYTICS_INGESTION_FAILURE_PERCENT="5"
ANALYTICS_INGESTION_MIN_BATCHES="20"
ANALYTICS_CONTRACT_REJECTION_ALERT="5"

# How old an ingestion health window must be before a batch flushes it to the operational
# metric table. 0 flushes on every batch, which is what the verification scripts use.
ANALYTICS_HEALTH_FLUSH_MINUTES="5"

# Retention (§4.7). Raw events are the shortest window and aggregates the longest, on purpose:
# a merchant comparing this February to last February must not be told the past was empty.
ANALYTICS_RAW_RETENTION_DAYS="90"
ANALYTICS_VISITOR_RETENTION_MONTHS="13"
ANALYTICS_AGGREGATE_RETENTION_MONTHS="24"
ANALYTICS_RECEIPT_RETENTION_MONTHS="24"
ANALYTICS_SESSION_TIMEOUT_MINUTES="30"
ANALYTICS_ACTIVE_WINDOW_MINUTES="5"

# Cloudflare R2 bucket for owner-uploaded images (lib/storage.ts). Set all five or none. Required
# in production; in development, leaving them unset stores uploads in public/uploads/ instead.
# Keys: R2 -> Manage API Tokens -> Object Read & Write, scoped to this bucket.
# R2_PUBLIC_URL: the bucket's r2.dev URL (Settings -> Public Development URL) or a custom domain,
# no trailing slash. After changing it, run: pnpm uploads:migrate --rewrite-from=<old URL>
# R2_ACCOUNT_ID="your-32-char-cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="shop-uploads"
# R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# --- Phase 6: admin Web Push (§11, D56) -------------------------------------------------------
# All optional. Without them the app behaves exactly as it did before Phase 6: the shop sells,
# the admin works, and the notification screen says push is unavailable instead of offering a
# button that cannot work.
#
# Generate a VAPID pair once per deployment and keep the private key secret:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# PUSH_VAPID_SUBJECT is how a push service contacts you about your own pushes.
PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
PUSH_VAPID_SUBJECT="mailto:you@example.com"
# A subscription's endpoint is a capability: whoever holds it can push to that device until it is
# revoked. Encrypted at rest under its own 32-byte key, separate from LICENSE_ENCRYPTION_KEY so
# rotating one does not invalidate the other:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PUSH_ENCRYPTION_KEY=""
# How long one push attempt may take. Short on purpose: it runs inside after(), and a container
# may be shut down 10-30s after the response (§11.4).
PUSH_TIMEOUT_MS="2500"
# Only for the verification suite, and only outside production: one extra host the push endpoint
# allowlist will accept, so verify:notifications can point the sender at a server it controls
# (see lib/push/endpoint.ts). Ignored entirely when NODE_ENV=production.
# PUSH_TEST_ENDPOINT_HOST="127.0.0.1"
